# Environment variables template for RitaVo LMS
# Copy this to .env and fill in the values

# === DATABASE ===
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:123456@localhost:5432/security_video_db?schema=public"

# === JWT SECURITY ===
JWT_SECRET="your_jwt_secret_here"

# === BUNNY STREAM CLOUD CONFIG ===
BUNNY_LIBRARY_ID=your_library_id
BUNNY_API_KEY=your_api_key
BUNNY_CDN_HOSTNAME=your_cdn_hostname
