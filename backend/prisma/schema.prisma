generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. NHÓM QUẢN LÝ NGƯỜI DÙNG (USERS & ROLES)
// ==========================================

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(50) // admin, instructor, student
  description String?    @db.Text
  user_roles  UserRole[]

  @@map("roles")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  avatar        String?   @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  dob           DateTime?
  gender        String?   @db.VarChar(20)
  bio           String?   @db.Text
  employee_id   String?   @unique @db.VarChar(50)
  department    String?   @db.VarChar(100)
  position      String?   @db.VarChar(100)
  join_date     DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime? // Soft Delete

  user_roles       UserRole[]
  instructed_courses Course[]     @relation("Instructor")
  enrollments      Enrollment[]
  reviews          Review[]
  wishlists        Wishlist[]
  completed_lessons LessonCompleted[]
  course_requests  CourseRequest[]
  notifications    Notification[]
  comments              Comment[]
  quizAttempts          QuizAttempt[]
  instructed_programs   LearningProgram[]   @relation("ProgramInstructor")
  program_enrollments   ProgramEnrollment[]
  program_requests      ProgramRequest[]
  learning_sessions     LearningSession[]

  @@index([full_name])
  @@index([deleted_at])
  @@map("users")
}

model UserRole {
  user_id Int
  role_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

// ==========================================
// 2. NHÓM NỘI DUNG KHÓA HỌC (CONTENT)
// ==========================================

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  courses     Course[]

  @@map("categories")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id            Int          @id @default(autoincrement())
  category_id   Int?
  instructor_id Int
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  level         String?      @db.VarChar(50) // Căn bản, Trung cấp, Nâng cao
  thumbnail     String?      @db.VarChar(255)
  intro_video_url String?    @db.VarChar(255)
  learning_outcomes String?    @db.Text
  requirements    String?      @db.Text
  status        CourseStatus @default(DRAFT)
  is_private    Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted_at    DateTime?

  category    Category?    @relation(fields: [category_id], references: [id])
  instructor  User         @relation("Instructor", fields: [instructor_id], references: [id])
  sections    Section[]
  enrollments Enrollment[]
  reviews     Review[]
  wishlists   Wishlist[]
  requests        CourseRequest[]
  program_courses ProgramCourse[]

  @@index([status])
  @@index([instructor_id])
  @@map("courses")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CourseRequest {
  id          Int           @id @default(autoincrement())
  user_id     Int
  course_id   Int
  status      RequestStatus @default(PENDING)
  reason      String?       @db.Text
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course        @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([created_at])
  @@map("course_requests")
}

model Section {
  id        Int      @id @default(autoincrement())
  course_id Int
  title     String   @db.VarChar(255)
  order     Int      @default(0)
  course    Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  lessons   Lesson[]

  @@map("sections")
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
}

model Lesson {
  id          Int        @id @default(autoincrement())
  section_id  Int
  title       String     @db.VarChar(255)
  type        LessonType @default(VIDEO)
  video_url   String?    @db.VarChar(255) // manifest_url cũ
  source_url  String?    @db.VarChar(500) // URL video gốc từ server công ty
  content     String?    @db.Text         // Nội dung bài học (Markdown/Text)
  
  // Tài liệu đính kèm (PDF)
  attachment_url  String? @db.VarChar(255)
  attachment_name String? @db.VarChar(255)

  duration    Int?       @default(0)      // Tính theo giây
  order       Int        @default(0)
  is_free     Boolean    @default(false)
  anti_seek   Boolean    @default(true)  // Bật chống tua mặc định
  
  // Các field cho HLS bảo mật tối thượng
  hls_key     Bytes?   // Lưu trực tiếp Binary Key
  hls_iv      String?  @db.VarChar(50)

  section     Section           @relation(fields: [section_id], references: [id], onDelete: Cascade)
  completions LessonCompleted[]
  comments    Comment[]
  quiz        Quiz?

  @@map("lessons")
}

// ==========================================
// 4. TIẾN ĐỘ & TƯƠNG TÁC (PROGRESS)
// ==========================================

model Enrollment {
  user_id     Int
  course_id   Int
  enrolled_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@id([user_id, course_id])
  @@map("enrollments")
}

model LessonCompleted {
  user_id      Int
  lesson_id    Int
  completed_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@id([user_id, lesson_id])
  @@map("lesson_completed")
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  course_id  Int
  rating     Int      @default(5) // 1-5 sao
  comment    String?  @db.Text
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  course Course @relation(fields: [course_id], references: [id])

  @@map("reviews")
}

model Wishlist {
  user_id    Int
  course_id  Int
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@id([user_id, course_id])
  @@map("wishlists")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String   @db.VarChar(255)
  message    String   @db.Text
  type       String?  @db.VarChar(50) // e.g., 'COURSE_APPROVAL', 'COURSE_REJECTION'
  link       String?  @db.VarChar(500) // Link điều hướng khi click thông báo
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
  @@map("notifications")
}

model Comment {
  id         Int      @id @default(autoincrement())
  lesson_id  Int
  user_id    Int
  parent_id  Int?     // Cho cấp độ 2 (Phản hồi)
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lesson  Lesson    @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([lesson_id])
  @@index([created_at])
  @@map("comments")
}

// ==========================================
// 5. NHÓM CHƯƠNG TRÌNH HỌC (LEARNING PROGRAMS)
// ==========================================

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LearningProgram {
  id            Int           @id @default(autoincrement())
  instructor_id Int
  title         String        @db.VarChar(255)
  description   String?       @db.Text
  thumbnail     String?       @db.VarChar(255)
  level         String?       @db.VarChar(50)
  status        ProgramStatus @default(DRAFT)
  is_private    Boolean       @default(false)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?

  instructor  User                @relation("ProgramInstructor", fields: [instructor_id], references: [id])
  courses     ProgramCourse[]
  enrollments ProgramEnrollment[]
  requests    ProgramRequest[]

  @@map("learning_programs")
}

model ProgramCourse {
  program_id Int
  course_id  Int
  order      Int @default(0)

  program LearningProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)
  course  Course          @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@id([program_id, course_id])
  @@map("program_courses")
}

model ProgramEnrollment {
  user_id     Int
  program_id  Int
  enrolled_at DateTime @default(now())

  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  program LearningProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@id([user_id, program_id])
  @@map("program_enrollments")
}

model ProgramRequest {
  id          Int           @id @default(autoincrement())
  user_id     Int
  program_id  Int
  status      RequestStatus @default(PENDING)
  reason      String?       @db.Text
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  program     LearningProgram @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@map("program_requests")
}


// ==========================================
// 6. NHÓM TRẮC NGHIỆM (QUIZ)
// ==========================================

model Quiz {
  id          Int      @id @default(autoincrement())
  lesson_id   Int      @unique          // 1 lesson QUIZ = 1 quiz
  description String?  @db.Text
  pass_score  Int      @default(80)     // Điểm đạt (0-100)
  time_limit  Int?                      // Giới hạn (giây), null = không hạn

  lesson    Lesson     @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
  @@map("quizzes")
}

model Question {
  id          Int      @id @default(autoincrement())
  quiz_id     Int
  content     String   @db.Text
  image_url   String?  @db.VarChar(255)
  explanation String?  @db.Text
  order       Int      @default(0)

  quiz    Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  options Option[]
  answers StudentAnswer[]
  @@map("questions")
}

model Option {
  id          Int     @id @default(autoincrement())
  question_id Int
  content     String  @db.Text
  is_correct  Boolean @default(false)

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]
  @@map("options")
}

model QuizAttempt {
  id           Int       @id @default(autoincrement())
  user_id      Int
  quiz_id      Int
  score        Int       @default(0)
  status       String    @default("IN_PROGRESS") @db.VarChar(20)
  started_at   DateTime  @default(now())
  completed_at DateTime?

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  answers StudentAnswer[]
  @@map("quiz_attempts")
}

model StudentAnswer {
  id          Int @id @default(autoincrement())
  attempt_id  Int
  question_id Int
  option_id   Int

  attempt  QuizAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)
  option   Option      @relation(fields: [option_id], references: [id], onDelete: Cascade)
  @@map("student_answers")
}

model LearningSession {
  id          Int      @id @default(autoincrement())
  user_id     Int
  lesson_id   Int?     // Đôi khi chỉ cần biết đang học khóa nào
  course_id   Int?     // Thêm course_id để thống kê theo khóa dễ hơn
  duration    Int      @default(0) // Giây
  date        DateTime @default(now()) @db.Date // Chỉ lưu ngày

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id, date]) // Một ngày một khóa học chỉ có 1 bản ghi tổng hợp
  @@map("learning_sessions")
}
// ==========================================
// 7. QUẢN LÝ BANNER & GIAO DIỆN (UI/UX)
// ==========================================

model HeroBanner {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  image_url   String?  @db.VarChar(500)
  button_text String?  @db.VarChar(50)
  button_link String?  @db.VarChar(500)
  stat_value  String?  @db.VarChar(50)  // Ví dụ: "24+ khóa học"
  color_code  String?  @db.VarChar(20)   // Mã màu nền (hex)
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("hero_banners")
}
